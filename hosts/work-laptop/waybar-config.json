{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/slack", "custom/zoom", "pulseaudio", "network", "cpu", "memory", "battery", "tray"],

    "niri/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "niri/window": {
        "format": "{}",
        "max-length": 50
    },

    "clock": {
        "timezone": "America/New_York",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M %Y-%m-%d}",
        "format-alt": "{:%A, %B %d, %Y}"
    },

    "cpu": {
        "interval": 10,
        "format": " {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 30,
        "format": " {}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },

    "pulseaudio": {
        "scroll-step": 5,
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "custom/slack": {
        "format": " ",
        "on-click": "slack",
        "tooltip": true,
        "tooltip-format": "Open Slack"
    },

    "custom/zoom": {
        "format": " ",
        "on-click": "zoom-us",
        "tooltip": true,
        "tooltip-format": "Open Zoom"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
